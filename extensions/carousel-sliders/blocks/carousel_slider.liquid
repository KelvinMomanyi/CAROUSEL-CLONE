{%liquid
assign s = block.settings
assign c = blank
if s.collection_source == 'selected'
assign c = s.selected_collection
else
assign c = collections.all
endif
assign n = s.products_limit|default: 8|at_most: 16
assign id = 'shv-carousel-'|append: block.id
%}
{%if c != blank and c.products_count > 0%}
<div
id="{{id}}"
class="shv-main-slider{%if s.enable_gradient_background%} shv-gradient-enabled shv-gradient-{{s.gradient_shape}}{%endif%}"
data-shv-main-slider
data-carousel-root
data-carousel-layout="slider-main"
data-carousel-block-id="{{block.id}}"
style="
--theme-accent: {{s.gradient_color_start|default: '#f1683a'}};
--theme-text: {{s.custom_text_color|default: '#ffffff'}};
--theme-bg: #111418;
{%render 'carousel-responsive-variables', s: s, c: c%}
"
role="region"
aria-roledescription="carousel"
aria-label="{{s.accessibility_label|escape}}"
{{block.shopify_attributes}}
>
{%render 'carousel-main-content', c: c, n: n, modern: false%}
</div>
{%elsif request.design_mode%}
<div class="slider-liquid-empty" role="status" {{block.shopify_attributes}}>{{'carousel.empty.collection'|t}}</div>
{%endif%}
{%schema%}{"name":"Carousel Slider","target":"section","stylesheet":"slider-main.css","javascript":"slider-main.js","disabled_on":{"groups":["header","footer"]},"settings":[{"type":"text","id":"accessibility_label","label":"Accessibility label","default":"Featured products"},{"type":"select","id":"collection_source","label":"Product source","options":[{"value":"all","label":"All products"},{"value":"selected","label":"Selected collection"}],"default":"all"},{"type":"collection","id":"selected_collection","label":"Collection"},{"type":"range","id":"products_limit","label":"Maximum products","min":2,"max":16,"step":1,"default":8},{"type":"range","id":"section_height","label":"Section height","min":360,"max":900,"step":20,"unit":"px","default":700},{"type":"header","content":"Large screen"},{"type":"select","id":"aspect_ratio_large","label":"Aspect ratio","options":[{"value":"auto","label":"Auto"},{"value":"16/9","label":"16:9"},{"value":"21/9","label":"21:9"},{"value":"4/3","label":"4:3"},{"value":"3/2","label":"3:2"},{"value":"1/1","label":"1:1"},{"value":"3/4","label":"3:4"},{"value":"9/16","label":"9:16"}],"default":"auto"},{"type":"select","id":"image_fit_large","label":"Image fit","options":[{"value":"contain","label":"Contain"},{"value":"cover","label":"Cover"}],"default":"cover"},{"type":"header","content":"Medium screen"},{"type":"select","id":"aspect_ratio_medium","label":"Aspect ratio","options":[{"value":"auto","label":"Auto"},{"value":"16/9","label":"16:9"},{"value":"4/3","label":"4:3"},{"value":"3/2","label":"3:2"},{"value":"1/1","label":"1:1"},{"value":"3/4","label":"3:4"},{"value":"9/16","label":"9:16"}],"default":"auto"},{"type":"select","id":"image_fit_medium","label":"Image fit","options":[{"value":"contain","label":"Contain"},{"value":"cover","label":"Cover"}],"default":"cover"},{"type":"header","content":"Small screen"},{"type":"select","id":"aspect_ratio_small","label":"Aspect ratio","options":[{"value":"auto","label":"Auto"},{"value":"9/16","label":"9:16"},{"value":"3/4","label":"3:4"},{"value":"1/1","label":"1:1"},{"value":"4/3","label":"4:3"},{"value":"16/9","label":"16:9"}],"default":"auto"},{"type":"select","id":"image_fit_small","label":"Image fit","options":[{"value":"contain","label":"Contain"},{"value":"cover","label":"Cover"}],"default":"cover"},{"type":"header","content":"Text"},{"type":"color","id":"custom_text_color","label":"Text color","default":"#ffffff"},{"type":"text","id":"custom_title_size","label":"Title font size"},{"type":"text","id":"custom_subtitle_size","label":"Product name font size"},{"type":"text","id":"custom_price_size","label":"Price font size"},{"type":"text","id":"custom_button_size","label":"Button font size"},{"type":"header","content":"Accent"},{"type":"checkbox","id":"enable_gradient_background","label":"Enable animated accent","default":true},{"type":"select","id":"gradient_shape","label":"Accent shape","options":[{"value":"rectangle","label":"Rectangle"},{"value":"rounded","label":"Rounded"},{"value":"pill","label":"Pill"},{"value":"slashed","label":"Slashed"},{"value":"angled-left","label":"Angled left"},{"value":"angled-right","label":"Angled right"},{"value":"chevron-right","label":"Chevron right"},{"value":"chevron-left","label":"Chevron left"},{"value":"notch-right","label":"Notch right"},{"value":"wave","label":"Wave"},{"value":"diagonal-cut","label":"Diagonal cut"}],"default":"rounded"},{"type":"range","id":"gradient_border_radius","label":"Accent radius","min":0,"max":50,"step":1,"default":18,"unit":"px"},{"type":"color","id":"gradient_color_start","label":"Accent start","default":"#f1683a"},{"type":"color","id":"gradient_color_end","label":"Accent end","default":"#8a2be2"}]}{%endschema%}
