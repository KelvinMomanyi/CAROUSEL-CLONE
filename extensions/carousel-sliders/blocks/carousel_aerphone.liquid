{%- assign s=block.settings -%}
{%liquid
assign id = 'slider-03-'|append: block.id
if s.collection_source == 'selected'
assign c = s.selected_collection
else
assign c = collections.all
endif
assign m = s.products_limit|default: 6
assign d = s.products_display_mode|default: 'limited'
assign n = m
if d == 'all'
assign n = c.products_count|default: c.products.size|at_most: 12
endif
%}
{%if c != blank and c.products_count > 0%}
<div
id="{{id}}"
class="slider-03-root{%if s.text_color != blank%} has-slider-text-color{%endif%}{%if s.text_font_size != blank%} has-slider-text-size{%endif%}{%if s.button_color != blank%} has-slider-button-color{%endif%}{%if s.button_text_color != blank%} has-slider-button-text-color{%endif%}{%if s.button_font_size != blank%} has-slider-button-size{%endif%}"
data-slider-03
data-carousel-root
data-carousel-layout="slider-03"
data-carousel-block-id="{{block.id}}"
role="region"
aria-roledescription="carousel"
aria-label="{{s.accessibility_label|escape}}"
style="
--slider-03-height: {{s.section_height|escape}};
{%if s.text_color != blank%}--slider-style-text-color: {{s.text_color}};{%endif%}
{%if s.text_font_size != blank%}--slider-style-text-size: {{s.text_font_size|escape}};{%endif%}
{%if s.button_color != blank%}--slider-style-button-color: {{s.button_color}};{%endif%}
{%if s.button_text_color != blank%}--slider-style-button-text-color: {{s.button_text_color}};{%endif%}
{%if s.button_font_size != blank%}--slider-style-button-size: {{s.button_font_size|escape}};{%endif%}
"
{{block.shopify_attributes}}
>
<div class="carousel">
<div class="list">
{%for p in c.products limit: n%}
{%assign v = p.selected_or_first_available_variant%}
<div class="item">
{%if p.featured_image%}
{%assign l = 'lazy'%}{%if forloop.first%}{%assign l = 'eager'%}{%endif%}
{{p.featured_image|image_url: width: 1800|image_tag: widths: '360, 640, 960, 1200, 1800', sizes: '(max-width: 767px) 70vw, 45vw', loading: l, alt: p.featured_image.alt|default: p.title}}
{%else%}
{{'product-1'|placeholder_svg_tag: 'product-image-placeholder'}}
{%endif%}
<div class="introduce">
<div class="productName">{{p.title|escape}}</div>
<div class="productPrice">{{v.price|money_with_currency}}</div>
<div class="productActions">
{%if p.has_only_default_variant%}
<form action="{{routes.cart_add_url}}" method="post" enctype="multipart/form-data" class="addToCartForm" data-carousel-cart-form>
<input type="hidden" name="id" value="{{v.id}}">
<input type="hidden" name="quantity" value="1">
<button class="addToCart" type="submit"{%unless v.available%} disabled{%endunless%}>
{%if v.available%}{{'carousel.actions.add_to_cart'|t}}{%else%}{{'carousel.actions.sold_out'|t}}{%endif%}
</button>
</form>
{%else%}
<a class="addToCart" href="{{p.url}}" data-product-id="{{p.id}}" data-product-url>{{'carousel.actions.choose_options'|t}}</a>
{%endif%}
<p class="cartFeedback" data-slider-03-cart-feedback aria-live="polite"></p>
</div>
</div>
<div class="detail">
<div class="title">{{p.title|escape}}</div>
<div class="des">{{p.description|strip_html|truncatewords: 50}}</div>
<div class="specifications">
<div>
<p>{{'carousel.product.price'|t}}</p>
<p>{{v.price|money_with_currency}}</p>
</div>
<div>
<p>{{'carousel.product.vendor'|t}}</p>
<p>{{p.vendor|default: shop.name|escape}}</p>
</div>
<div>
<p>{{'carousel.product.type'|t}}</p>
<p>{%if p.type != blank%}{{p.type|escape}}{%else%}{{'carousel.product.default_type'|t}}{%endif%}</p>
</div>
<div>
<p>{{'carousel.product.status'|t}}</p>
<p>{%if v.available%}{{'carousel.product.in_stock'|t}}{%else%}{{'carousel.actions.sold_out'|t}}{%endif%}</p>
</div>
<div>
<p>{{'carousel.product.link'|t}}</p>
<p>{{p.handle|escape}}</p>
</div>
</div>
<div class="checkout">
<button type="button" data-url="{{p.url}}" data-product-id="{{p.id}}" data-product-url>{{'carousel.actions.view_product'|t}}</button>
<p class="cartFeedback cartFeedback--detail" data-slider-03-cart-feedback aria-live="polite"></p>
</div>
</div>
</div>
{%endfor%}
</div>
<div class="arrows">
<button data-slider-03-prev type="button" aria-label="{{'carousel.controls.previous'|t}}">&#8249;</button>
<button data-slider-03-next type="button" aria-label="{{'carousel.controls.next'|t}}">&#8250;</button>
</div>
</div>
</div>
{%elsif request.design_mode%}
<div class="slider-liquid-empty" {{block.shopify_attributes}}>
{{'carousel.empty.collection'|t}}
</div>
{%endif%}
{%schema%}{"name":"Carousel: Aerphone","target":"section","stylesheet":"slider-03-aerphone.css","javascript":"slider-03-aerphone.js","settings":[{"type":"text","id":"accessibility_label","label":"Accessibility label","default":"Featured products"},{"type":"select","id":"collection_source","label":"Product source","options":[{"value":"all","label":"All products"},{"value":"selected","label":"Selected collection"}],"default":"all"},{"type":"collection","id":"selected_collection","label":"Collection"},{"type":"select","id":"products_display_mode","label":"Products to show","options":[{"value":"limited","label":"Set number"},{"value":"all","label":"Maximum supported"}],"default":"limited"},{"type":"range","id":"products_limit","label":"Number of products","min":3,"max":12,"step":1,"default":6},{"type":"header","content":"Style Settings"},{"type":"text","id":"section_height","label":"Section height","default":"800px"},{"type":"header","content":"Text and Button Styling"},{"type":"color","id":"text_color","label":"Text color"},{"type":"text","id":"text_font_size","label":"Text font size","info":"Use a CSS size, for example 18px or 1.2rem."},{"type":"color","id":"button_color","label":"Button color"},{"type":"color","id":"button_text_color","label":"Button text color"},{"type":"text","id":"button_font_size","label":"Button font size","info":"Use a CSS size, for example 16px or 1rem."}],"disabled_on":{"groups":["header","footer"]}}{%endschema%}
