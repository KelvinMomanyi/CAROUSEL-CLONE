{% render 'analytics' %}
{%-assign s=block.settings-%}
{%liquid
assign id='slider-09-'|append:block.id
if s.collection_source =='selected'
assign c=s.selected_collection
else
assign c=collections.all
endif
assign m=s.products_limit|default:3
assign d=s.products_display_mode|default:'limited'
assign n=m
if d =='all'
assign n=c.products_count|default:c.products.size|at_most:8
endif%}
{%if c != blank and c.products_count > 0%}
<div id="{{id}}" class="slider-09-root{%if s.text_color != blank%} has-slider-text-color{%endif%}{%if s.text_font_size != blank%} has-slider-text-size{%endif%}{%if s.button_color != blank%} has-slider-button-color{%endif%}{%if s.button_text_color != blank%} has-slider-button-text-color{%endif%}{%if s.button_font_size != blank%} has-slider-button-size{%endif%}" data-carousel-root data-carousel-layout="slider-09" data-carousel-block-id="{{block.id}}" role="region" aria-roledescription="carousel" aria-label="{{s.accessibility_label|escape}}" style="
--s09-height: {{s.section_height|escape}};
{%if s.text_color != blank%}--slider-style-text-color: {{s.text_color}};{%endif%}
{%if s.text_font_size != blank%}--slider-style-text-size: {{s.text_font_size|escape}};{%endif%}
{%if s.button_color != blank%}--slider-style-button-color: {{s.button_color}};{%endif%}
{%if s.button_text_color != blank%}--slider-style-button-text-color: {{s.button_text_color}};{%endif%}
{%if s.button_font_size != blank%}--slider-style-button-size: {{s.button_font_size|escape}};{%endif%}
" {{block.shopify_attributes}}>
<div class="carousel">
<div class="list">
{%for p in c.products limit:n%}
{%assign v=p.selected_or_first_available_variant%}
{%assign mod=forloop.index0|modulo:3%}
{%case mod%}
{%when 0%}{%assign bg=s.color_1%}
{%when 1%}{%assign bg=s.color_2%}
{%else%}{%assign bg=s.color_3%}
{%endcase%}
<div class="item{%if forloop.first%} active{%endif%}"
data-title="{{p.title|escape}}"
style="--img-src: {%if p.featured_image%}url('{{p.featured_image|image_url:width:1200}}'){%else%}none{%endif%}; --bg-color: {{bg}};">
<div class="content">
<div class="image">
<div class="image-mask"></div>
{%if p.featured_image%}
{{p.featured_image|image_url:width:800|image_tag:widths:'240, 480, 800',sizes:'(max-width: 767px) 260px, 360px',loading:'lazy',class:'creative-product-img',alt:p.featured_image.alt|default:p.title}}
{%else%}
{{'product-1'|placeholder_svg_tag:'creative-product-img'}}
{%endif%}
</div>
<div class="info">
<div class="title">{{p.title|escape}}</div>
<div class="price">
{%if v.compare_at_price > v.price%}
<span class="compare">{{v.compare_at_price|money_with_currency}}</span>
{%endif%}
<span>{{v.price|money_with_currency}}</span>
</div>
<div class="actions">
{%if p.has_only_default_variant%}
<form action="{{routes.cart_add_url}}" method="post" enctype="multipart/form-data" data-slider-09-cart-form data-carousel-cart-form>
<input type="hidden" name="id" value="{{v.id}}">
<input type="hidden" name="quantity" value="1">
<button class="add-to-cart" type="submit"{%unless v.available%} disabled{%endunless%}>
<span data-slider-09-cart-label>{%if v.available%}{{'carousel.actions.add_to_cart'|t}}{%else%}{{'carousel.actions.sold_out'|t}}{%endif%}</span>
</button>
</form>
{%else%}
<a class="add-to-cart" href="{{p.url}}" data-product-id="{{p.id}}" data-product-url>{{'carousel.actions.choose_options'|t}}</a>
{%endif%}
<p class="cart-feedback" data-slider-09-cart-feedback aria-live="polite"></p>
</div>
</div>
</div>
</div>
{%endfor%}
</div>
<div class="arrows">
<button class="arrows-prev" type="button" aria-label="{{'carousel.controls.previous'|t}}">&#8249;</button>
<button class="arrows-next" type="button" aria-label="{{'carousel.controls.next'|t}}">&#8250;</button>
</div>
<ul class="dots">
{%for p in c.products limit:n%}
<li{%if forloop.first%} class="active"{%endif%}><button type="button" aria-label="{{p.title|escape}}"></button></li>
{%endfor%}
</ul>
</div>
</div>
{%elsif request.design_mode%}
<div class="slider-liquid-empty" role="status" {{block.shopify_attributes}}>{{'carousel.empty.collection'|t}}</div>
{%endif%}
{%schema%}{"name":"t:av","target":"section","available_if":"{{ app.metafields.billing.pro_access }}","stylesheet":"slider-09.css","javascript":"slider-09.js","disabled_on":{"groups":["header","footer"]},"settings":[{"type":"text","id":"accessibility_label","label":"t:w","default":"t:x"},{"type":"select","id":"collection_source","label":"t:y","options":[{"value":"all","label":"t:z"},{"value":"selected","label":"t:aa"}],"default":"all"},{"type":"collection","id":"selected_collection","label":"t:ab"},{"type":"select","id":"products_display_mode","label":"t:ac","options":[{"value":"limited","label":"t:ad"},{"value":"all","label":"t:ae"}],"default":"limited"},{"type":"range","id":"products_limit","label":"t:af","min":2,"max":8,"step":1,"default":3},{"type":"text","id":"section_height","label":"t:s","default":"720px"},{"type":"header","content":"t:ai"},{"type":"color","id":"text_color","label":"t:aj"},{"type":"text","id":"text_font_size","label":"t:ak","info":"t:al"},{"type":"color","id":"button_color","label":"t:am"},{"type":"color","id":"button_text_color","label":"t:an"},{"type":"text","id":"button_font_size","label":"t:ao","info":"t:ap"},{"type":"color","id":"color_1","label":"Color 1","default":"#428372"},{"type":"color","id":"color_2","label":"Color 2","default":"#EEAA19"},{"type":"color","id":"color_3","label":"Color 3","default":"#e86c3f"}]}{%endschema%}
