{%render 'analytics'%}
{%-assign s=block.settings-%}
<section
data-carousel-root
data-carousel-layout="image_reveal"
data-carousel-block-id="{{block.id}}"
class="ms-section ms-section--hover-accordion"
style="--ms-bg: {{s.background_color}}; --ms-text: {{s.text_color}}; --ms-accent: {{s.accent_color}}; --ms-padding: {{s.vertical_padding}}px; --ms-radius: {{s.card_radius}}px; --ms-accordion-height: {{s.gallery_height}}px; --ms-accordion-gap: {{s.accordion_gap}}px; --ms-accordion-active: {{s.expanded_ratio}};"
{{block.shopify_attributes}}
>
<div class="ms-section__header">
<div>
{%if s.eyebrow != blank%}<p class="ms-section__eyebrow">{{s.eyebrow}}</p>{%endif%}
<h2 class="ms-section__heading">{{s.heading}}</h2>
{%if s.description != blank%}<p class="ms-section__copy">{{s.description}}</p>{%endif%}
</div>
</div>
<motion-hover-accordion class="ms-hover-accordion" data-start-index="{{s.start_panel|minus:1}}" role="group" aria-label="{{'motion.hover_accordion'|t|escape}}">
<button class="ms-hover-accordion__panel" type="button" data-accordion-panel aria-expanded="{%if s.start_panel == 1%}true{%else%}false{%endif%}" aria-label="{{'motion.expand_panel'|t:label:s.before_label|escape}}">
{%if s.before_image != blank%}
{{s.before_image|image_url:width:1800|image_tag:class:'ms-hover-accordion__image',loading:'lazy',widths:'360, 720, 1100, 1500, 1800',sizes:'(min-width: 900px) 60vw, 100vw',alt:s.before_image.alt|default:s.before_label}}
{%else%}
{{'lifestyle-1'|placeholder_svg_tag:'ms-hover-accordion__image ms-hover-accordion__placeholder'}}
{%endif%}
<span class="ms-hover-accordion__scrim" aria-hidden="true"></span>
<span class="ms-hover-accordion__meta"><span class="ms-hover-accordion__index">01</span><span class="ms-hover-accordion__label">{{s.before_label}}</span></span>
</button>
<button class="ms-hover-accordion__panel" type="button" data-accordion-panel aria-expanded="{%if s.start_panel == 2%}true{%else%}false{%endif%}" aria-label="{{'motion.expand_panel'|t:label:s.after_label|escape}}">
{%if s.after_image != blank%}
{{s.after_image|image_url:width:1800|image_tag:class:'ms-hover-accordion__image',loading:'lazy',widths:'360, 720, 1100, 1500, 1800',sizes:'(min-width: 900px) 60vw, 100vw',alt:s.after_image.alt|default:s.after_label}}
{%else%}
{{'lifestyle-2'|placeholder_svg_tag:'ms-hover-accordion__image ms-hover-accordion__placeholder'}}
{%endif%}
<span class="ms-hover-accordion__scrim" aria-hidden="true"></span>
<span class="ms-hover-accordion__meta"><span class="ms-hover-accordion__index">02</span><span class="ms-hover-accordion__label">{{s.after_label}}</span></span>
</button>
<button class="ms-hover-accordion__panel" type="button" data-accordion-panel aria-expanded="{%if s.start_panel == 3%}true{%else%}false{%endif%}" aria-label="{{'motion.expand_panel'|t:label:s.label_3|escape}}">
{%if s.image_3 != blank%}
{{s.image_3|image_url:width:1800|image_tag:class:'ms-hover-accordion__image',loading:'lazy',widths:'360, 720, 1100, 1500, 1800',sizes:'(min-width: 900px) 60vw, 100vw',alt:s.image_3.alt|default:s.label_3}}
{%else%}
{{'lifestyle-1'|placeholder_svg_tag:'ms-hover-accordion__image ms-hover-accordion__placeholder'}}
{%endif%}
<span class="ms-hover-accordion__scrim" aria-hidden="true"></span>
<span class="ms-hover-accordion__meta"><span class="ms-hover-accordion__index">03</span><span class="ms-hover-accordion__label">{{s.label_3}}</span></span>
</button>
<button class="ms-hover-accordion__panel" type="button" data-accordion-panel aria-expanded="{%if s.start_panel == 4%}true{%else%}false{%endif%}" aria-label="{{'motion.expand_panel'|t:label:s.label_4|escape}}">
{%if s.image_4 != blank%}
{{s.image_4|image_url:width:1800|image_tag:class:'ms-hover-accordion__image',loading:'lazy',widths:'360, 720, 1100, 1500, 1800',sizes:'(min-width: 900px) 60vw, 100vw',alt:s.image_4.alt|default:s.label_4}}
{%else%}
{{'lifestyle-2'|placeholder_svg_tag:'ms-hover-accordion__image ms-hover-accordion__placeholder'}}
{%endif%}
<span class="ms-hover-accordion__scrim" aria-hidden="true"></span>
<span class="ms-hover-accordion__meta"><span class="ms-hover-accordion__index">04</span><span class="ms-hover-accordion__label">{{s.label_4}}</span></span>
</button>
<button class="ms-hover-accordion__panel" type="button" data-accordion-panel aria-expanded="{%if s.start_panel == 5%}true{%else%}false{%endif%}" aria-label="{{'motion.expand_panel'|t:label:s.label_5|escape}}">
{%if s.image_5 != blank%}
{{s.image_5|image_url:width:1800|image_tag:class:'ms-hover-accordion__image',loading:'lazy',widths:'360, 720, 1100, 1500, 1800',sizes:'(min-width: 900px) 60vw, 100vw',alt:s.image_5.alt|default:s.label_5}}
{%else%}
{{'lifestyle-1'|placeholder_svg_tag:'ms-hover-accordion__image ms-hover-accordion__placeholder'}}
{%endif%}
<span class="ms-hover-accordion__scrim" aria-hidden="true"></span>
<span class="ms-hover-accordion__meta"><span class="ms-hover-accordion__index">05</span><span class="ms-hover-accordion__label">{{s.label_5}}</span></span>
</button>
</motion-hover-accordion>
</section>
{%schema%}{"name":"t:eg","target":"section","stylesheet":"motion-sections.css","javascript":"motion-hover-accordion.js","settings":[{"type":"image_picker","id":"before_image","label":"t:eh"},{"type":"text","id":"before_label","label":"t:em","default":"t:kb"},{"type":"image_picker","id":"after_image","label":"t:ei"},{"type":"text","id":"after_label","label":"t:eo","default":"t:kc"},{"type":"image_picker","id":"image_3","label":"t:kd"},{"type":"text","id":"label_3","label":"t:ke","default":"t:kf"},{"type":"image_picker","id":"image_4","label":"t:kg"},{"type":"text","id":"label_4","label":"t:kh","default":"t:ki"},{"type":"image_picker","id":"image_5","label":"t:kj"},{"type":"text","id":"label_5","label":"t:kk","default":"t:kl"},{"type":"header","content":"t:km"},{"type":"text","id":"eyebrow","label":"t:c","default":"t:ej"},{"type":"text","id":"heading","label":"t:e","default":"t:ek"},{"type":"textarea","id":"description","label":"t:g","default":"t:el"},{"type":"range","id":"start_panel","label":"t:eq","min":1,"max":5,"step":1,"default":1},{"type":"range","id":"gallery_height","label":"t:kn","min":360,"max":800,"step":20,"unit":"px","default":620},{"type":"range","id":"expanded_ratio","label":"t:ko","min":2,"max":8,"step":1,"default":5},{"type":"range","id":"accordion_gap","label":"t:kp","min":0,"max":24,"step":2,"unit":"px","default":12},{"type":"range","id":"card_radius","label":"t:er","min":0,"max":40,"step":2,"unit":"px","default":22},{"type":"range","id":"vertical_padding","label":"t:es","min":24,"max":120,"step":4,"unit":"px","default":72},{"type":"color","id":"background_color","label":"t:bs","default":"#e0eee5"},{"type":"color","id":"text_color","label":"t:aj","default":"#19372f"},{"type":"color","id":"accent_color","label":"t:u","default":"#287b62"}]}{%endschema%}
