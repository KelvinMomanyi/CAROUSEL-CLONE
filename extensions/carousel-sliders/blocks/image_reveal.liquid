{%- assign s=block.settings -%}
<section
class="ms-section"
style="--ms-bg: {{s.background_color}}; --ms-text: {{s.text_color}}; --ms-accent: {{s.accent_color}}; --ms-padding: {{s.vertical_padding}}px; --ms-radius: {{s.card_radius}}px;"
{{block.shopify_attributes}}
>
<div class="ms-section__header">
<div>
{%if s.eyebrow != blank%}<p class="ms-section__eyebrow">{{s.eyebrow}}</p>{%endif%}
<h2 class="ms-section__heading">{{s.heading}}</h2>
{%if s.description != blank%}<p class="ms-section__copy">{{s.description}}</p>{%endif%}
</div>
</div>
<motion-image-reveal class="ms-reveal" style="--ms-reveal: {{s.start_position}}%;">
{%if s.before_image != blank%}
{{s.before_image|image_url: width: 2000|image_tag: class: 'ms-reveal__image', loading: 'lazy', widths: '750, 1100, 1500, 2000', sizes: '100vw', alt: s.before_image.alt|default: s.before_label}}
{%else%}
{{'lifestyle-1'|placeholder_svg_tag: 'ms-reveal__image'}}
{%endif%}
<div class="ms-reveal__after">
{%if s.after_image != blank%}
{{s.after_image|image_url: width: 2000|image_tag: class: 'ms-reveal__image', loading: 'lazy', widths: '750, 1100, 1500, 2000', sizes: '100vw', alt: s.after_image.alt|default: s.after_label}}
{%else%}
{{'lifestyle-2'|placeholder_svg_tag: 'ms-reveal__image'}}
{%endif%}
</div>
<div class="ms-reveal__divider"><span class="ms-reveal__handle">↔</span></div>
<span class="ms-reveal__label ms-reveal__label--before">{{s.before_label}}</span>
<span class="ms-reveal__label ms-reveal__label--after">{{s.after_label}}</span>
<label class="ms-sr-only" for="MotionReveal-{{block.id}}">{{'motion.image_comparison'|t}}</label>
<input class="ms-reveal__range" id="MotionReveal-{{block.id}}" type="range" min="0" max="100" value="{{s.start_position}}">
</motion-image-reveal>
</section>
{%schema%}{"name":"Image reveal","target":"section","stylesheet":"motion-sections.css","javascript":"motion-sections.js","settings":[{"type":"image_picker","id":"before_image","label":"Before image"},{"type":"image_picker","id":"after_image","label":"After image"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"See the difference"},{"type":"text","id":"heading","label":"Heading","default":"A transformation you can feel"},{"type":"textarea","id":"description","label":"Description","default":"Drag the handle to compare materials, finishes, results or product details."},{"type":"text","id":"before_label","label":"Before label","default":"Before"},{"type":"text","id":"after_label","label":"After label","default":"After"},{"type":"range","id":"start_position","label":"Starting position","min":10,"max":90,"step":5,"unit":"%","default":50},{"type":"range","id":"card_radius","label":"Corner radius","min":0,"max":40,"step":2,"unit":"px","default":22},{"type":"range","id":"vertical_padding","label":"Vertical padding","min":24,"max":120,"step":4,"unit":"px","default":72},{"type":"color","id":"background_color","label":"Background","default":"#e0eee5"},{"type":"color","id":"text_color","label":"Text","default":"#19372f"},{"type":"color","id":"accent_color","label":"Accent","default":"#287b62"}]}{%endschema%}
