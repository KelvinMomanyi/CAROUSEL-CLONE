{%- assign s=block.settings -%}
<section
class="ms-section"
style="--ms-bg: {{s.background_color}}; --ms-text: {{s.text_color}}; --ms-accent: {{s.accent_color}}; --ms-padding: {{s.vertical_padding}}px;"
{{block.shopify_attributes}}
>
<motion-testimonials class="ms-testimonials" data-autoplay="{{s.autoplay_speed}}">
{%if s.eyebrow != blank%}<p class="ms-section__eyebrow">{{s.eyebrow}}</p>{%endif%}
<div class="ms-testimonials__viewport" aria-live="polite">
{%for index in (1..3)%}
{%liquid
if index == 1
assign quote = s.quote_1
assign author = s.author_1
elsif index == 2
assign quote = s.quote_2
assign author = s.author_2
else
assign quote = s.quote_3
assign author = s.author_3
endif
%}
{%if quote != blank%}
<article class="ms-testimonials__slide" data-testimonial-slide>
<div class="ms-testimonials__stars" aria-hidden="true">★★★★★</div>
<blockquote>“{{quote}}”</blockquote>
{%if author != blank%}<cite>{{author}}</cite>{%endif%}
</article>
{%endif%}
{%endfor%}
</div>
<div class="ms-testimonials__dots">
{%for index in (1..3)%}
<button class="ms-testimonials__dot" type="button" data-testimonial-dot aria-label="{{'motion.testimonial'|t: number: index}}"></button>
{%endfor%}
</div>
</motion-testimonials>
</section>
{%schema%}{"name":"Testimonial spotlight","target":"section","stylesheet":"motion-sections.css","javascript":"motion-sections.js","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Loved in the wild"},{"type":"header","content":"First testimonial"},{"type":"textarea","id":"quote_1","label":"Quote","default":"The quality is obvious the second you hold it. It feels considered, useful and made to last."},{"type":"text","id":"author_1","label":"Author","default":"Amara K. · Verified buyer"},{"type":"header","content":"Second testimonial"},{"type":"textarea","id":"quote_2","label":"Quote","default":"Beautifully simple, surprisingly versatile and now part of my everyday routine."},{"type":"text","id":"author_2","label":"Author","default":"Maya T. · Verified buyer"},{"type":"header","content":"Third testimonial"},{"type":"textarea","id":"quote_3","label":"Quote","default":"It arrived quickly, looked even better in person and the details are exceptional."},{"type":"text","id":"author_3","label":"Author","default":"Leo R. · Verified buyer"},{"type":"range","id":"autoplay_speed","label":"Autoplay delay","info":"Set to 0 to turn autoplay off.","min":0,"max":10,"step":1,"unit":"s","default":6},{"type":"range","id":"vertical_padding","label":"Vertical padding","min":40,"max":140,"step":4,"unit":"px","default":96},{"type":"color","id":"background_color","label":"Background","default":"#eee3cd"},{"type":"color","id":"text_color","label":"Text","default":"#302519"},{"type":"color","id":"accent_color","label":"Accent","default":"#9e5d36"}]}{%endschema%}
