{%render 'analytics'%}
{%-assign s=block.settings-%}
{%liquid
assign c=s.collection
if s.direction =='right'
assign marquee_direction='reverse'
else
assign marquee_direction='normal'
endif%}
<section
data-carousel-root
data-carousel-layout="infinite_marquee"
data-carousel-block-id="{{block.id}}"
class="ms-section"
style="--ms-bg: {{s.background_color}}; --ms-text: {{s.text_color}}; --ms-accent: {{s.accent_color}}; --ms-padding: {{s.vertical_padding}}px; --ms-gap: {{s.card_gap}}px; --ms-radius: {{s.card_radius}}px;"
{{block.shopify_attributes}}
>
<div class="ms-section__header">
<div>
{%if s.eyebrow != blank%}<p class="ms-section__eyebrow">{{s.eyebrow}}</p>{%endif%}
<h2 class="ms-section__heading">{{s.heading}}</h2>
</div>
</div>
<div class="ms-marquee" style="--ms-duration: {{s.speed}}s; --ms-direction: {{marquee_direction}};">
{%for duplicate in (1..2)%}
<div class="ms-marquee__set"{%if duplicate ==2%} aria-hidden="true"{%endif%}>
{%if c != blank and c.products_count > 0%}
{%for p in c.products limit:s.product_limit%}
{%render 'motion-product-card',product:p%}
{%endfor%}
{%else%}
{%for index in (1..6)%}
<article class="ms-product-card">
<div class="ms-product-card__media">{{'product-'|append:index|placeholder_svg_tag:'ms-product-card__placeholder'}}</div>
<div class="ms-product-card__meta">
<h3 class="ms-product-card__title">{{'motion.sample_product'|t:number:index}}</h3>
<p class="ms-product-card__price">{{4900|money}}</p>
</div>
</article>
{%endfor%}
{%endif%}
</div>
{%endfor%}
</div>
</section>
{%schema%}{"name":"t:et","target":"section","stylesheet":"motion-sections.css","settings":[{"type":"collection","id":"collection","label":"t:ab"},{"type":"text","id":"eyebrow","label":"t:c","default":"On repeat"},{"type":"text","id":"heading","label":"t:e","default":"t:ev"},{"type":"range","id":"product_limit","label":"t:ew","min":4,"max":12,"step":1,"default":8},{"type":"select","id":"direction","label":"Direction","options":[{"value":"left","label":"Left"},{"value":"right","label":"Right"}],"default":"left"},{"type":"range","id":"speed","label":"t:fa","min":12,"max":60,"step":2,"unit":"s","default":30},{"type":"range","id":"card_gap","label":"t:fb","min":8,"max":36,"step":2,"unit":"px","default":18},{"type":"range","id":"card_radius","label":"t:fc","min":0,"max":40,"step":2,"unit":"px","default":18},{"type":"range","id":"vertical_padding","label":"t:es","min":24,"max":120,"step":4,"unit":"px","default":64},{"type":"color","id":"background_color","label":"t:bs","default":"#f4c8b8"},{"type":"color","id":"text_color","label":"Text","default":"#341c20"},{"type":"color","id":"accent_color","label":"t:u","default":"#9d263e"}]}{%endschema%}
