{% render 'analytics' %}
{%-assign s=block.settings-%}
<section
data-carousel-root
data-carousel-layout="shoppable_gallery"
data-carousel-block-id="{{block.id}}"
class="ms-section"
style="--ms-bg: {{s.background_color}}; --ms-text: {{s.text_color}}; --ms-accent: {{s.accent_color}}; --ms-padding: {{s.vertical_padding}}px; --ms-gap: {{s.gap}}px; --ms-radius: {{s.card_radius}}px;"
{{block.shopify_attributes}}
>
<div class="ms-section__header">
<div>
{%if s.eyebrow != blank%}<p class="ms-section__eyebrow">{{s.eyebrow}}</p>{%endif%}
<h2 class="ms-section__heading">{{s.heading}}</h2>
{%if s.description != blank%}<p class="ms-section__copy">{{s.description}}</p>{%endif%}
</div>
</div>
<div class="ms-gallery">
{%for index in (1..3)%}
{%liquid
if index ==1
assign gallery_image=s.image_1
assign gallery_product=s.products[0]
assign hotspot_x=s.hotspot_x_1
assign hotspot_y=s.hotspot_y_1
elsif index ==2
assign gallery_image=s.image_2
assign gallery_product=s.products[1]
assign hotspot_x=s.hotspot_x_2
assign hotspot_y=s.hotspot_y_2
else
assign gallery_image=s.image_3
assign gallery_product=s.products[2]
assign hotspot_x=s.hotspot_x_3
assign hotspot_y=s.hotspot_y_3
endif%}
<article class="ms-gallery__item">
{%if gallery_image != blank%}
{{gallery_image|image_url:width:1800|image_tag:loading:'lazy',widths:'500, 750, 1100, 1500, 1800',sizes:'(min-width: 750px) 65vw, 100vw',alt:gallery_image.alt|default:gallery_product.title}}
{%else%}
{{'lifestyle-'|append:index|placeholder_svg_tag}}
{%endif%}
{%if gallery_product != blank%}
<a
class="ms-hotspot"
href="{{gallery_product.url}}"
style="--ms-hotspot-x: {{hotspot_x}}%; --ms-hotspot-y: {{hotspot_y}}%;"
data-label="{{gallery_product.title|escape}}"
aria-label="{{'motion.shop_product'|t:product:gallery_product.title|escape}}"
>+</a>
{%endif%}
</article>
{%endfor%}
</div>
</section>
{%schema%}{"name":"t:jb","target":"section","available_if":"{{ app.metafields.billing.pro_access }}","stylesheet":"motion-sections.css","settings":[{"type":"text","id":"eyebrow","label":"t:c","default":"t:jc"},{"type":"text","id":"heading","label":"t:e","default":"t:jd"},{"type":"textarea","id":"description","label":"t:g","default":"t:je"},{"type":"product_list","id":"products","label":"t:jf","limit":3},{"type":"header","content":"t:jg"},{"type":"image_picker","id":"image_1","label":"t:b"},{"type":"range","id":"hotspot_x_1","label":"t:jh","min":5,"max":95,"step":5,"unit":"%","default":55},{"type":"range","id":"hotspot_y_1","label":"t:ji","min":5,"max":95,"step":5,"unit":"%","default":55},{"type":"header","content":"t:jj"},{"type":"image_picker","id":"image_2","label":"t:b"},{"type":"range","id":"hotspot_x_2","label":"t:jh","min":5,"max":95,"step":5,"unit":"%","default":60},{"type":"range","id":"hotspot_y_2","label":"t:ji","min":5,"max":95,"step":5,"unit":"%","default":50},{"type":"header","content":"t:jk"},{"type":"image_picker","id":"image_3","label":"t:b"},{"type":"range","id":"hotspot_x_3","label":"t:jh","min":5,"max":95,"step":5,"unit":"%","default":45},{"type":"range","id":"hotspot_y_3","label":"t:ji","min":5,"max":95,"step":5,"unit":"%","default":60},{"type":"range","id":"gap","label":"t:jl","min":0,"max":30,"step":2,"unit":"px","default":14},{"type":"range","id":"card_radius","label":"t:er","min":0,"max":40,"step":2,"unit":"px","default":20},{"type":"range","id":"vertical_padding","label":"t:es","min":24,"max":120,"step":4,"unit":"px","default":72},{"type":"color","id":"background_color","label":"t:bs","default":"#f6eceb"},{"type":"color","id":"text_color","label":"Text","default":"#3b202c"},{"type":"color","id":"accent_color","label":"t:u","default":"#a44365"}]}{%endschema%}
