{% render 'analytics' %}
{%-assign s=block.settings-%}
{%liquid
assign id='slider-10-'|append:block.id
if s.collection_source =='selected'
assign c=s.selected_collection
else
assign c=collections.all
endif
assign m=s.products_limit|default:3
assign d=s.products_display_mode|default:'limited'
assign n=m
if d =='all'
assign n=c.products_count|default:c.products.size|at_most:8
endif%}
{%if c != blank and c.products_count > 0%}
<div
id="{{id}}"
class="slider-10-root gradient{%if s.text_color != blank%} has-slider-text-color{%endif%}{%if s.text_font_size != blank%} has-slider-text-size{%endif%}{%if s.button_color != blank%} has-slider-button-color{%endif%}{%if s.button_text_color != blank%} has-slider-button-text-color{%endif%}{%if s.button_font_size != blank%} has-slider-button-size{%endif%}" data-block-id="{{block.id}}"
data-carousel-root
data-carousel-layout="slider-10"
data-carousel-block-id="{{block.id}}"
role="region"
aria-roledescription="carousel"
aria-label="{{s.accessibility_label|escape}}"
style="{%render 'carousel-color-variables',s:s%}--s10-height: {{s.section_height|escape}};"
{{block.shopify_attributes}}
>
<div class="container">
<div id="slide-{{block.id}}">
{%for p in c.products limit:n%}
{%assign v=p.selected_or_first_available_variant%}
<div class="item">
<div class="image">
{%if p.featured_image%}
{{p.featured_image|image_url:width:1400|image_tag:widths:'360, 640, 960, 1400',sizes:'(max-width: 560px) 80vw, 55vw',loading:'lazy',alt:p.featured_image.alt|default:p.title}}
{%else%}
{{'product-1'|placeholder_svg_tag:'product-image-placeholder'}}
{%endif%}
</div>
<div class="content">
<div class="left">
<h2>{{p.title|escape}}</h2>
<div class="des">{{p.description|strip_html|truncatewords:22}}</div>
{%if p.has_only_default_variant%}
<form action="{{routes.cart_add_url}}" method="post" data-carousel-cart-form>
<input type="hidden" name="id" value="{{v.id}}">
<input type="hidden" name="quantity" value="1">
<button class="add-to-cart" type="submit"{%unless v.available%} disabled{%endunless%}>{%if v.available%}{{'carousel.actions.add_to_cart'|t}}{%else%}{{'carousel.actions.sold_out'|t}}{%endif%}</button>
</form>
{%else%}
<button class="add-to-cart" type="button" data-url="{{p.url}}" data-product-id="{{p.id}}" data-product-url>{{'carousel.actions.choose_options'|t}}</button>
{%endif%}
<button class="see-more" type="button" data-url="{{p.url}}" data-product-id="{{p.id}}" data-product-url>{{'carousel.actions.view_product'|t}} <span aria-hidden="true">&#8250;&#8250;&#8250;</span></button>
</div>
<div class="right">
<h2>{{'carousel.product.details'|t}}</h2>
<ul>
<li><p>{{'carousel.product.price'|t}}</p><p>{{p.price|money}}</p></li>
<li><p>{{'carousel.product.vendor'|t}}</p><p>{{p.vendor|default:shop.name|escape}}</p></li>
<li><p>{{'carousel.product.type'|t}}</p><p>{%if p.type != blank%}{{p.type|escape}}{%else%}{{'carousel.product.default_type'|t}}{%endif%}</p></li>
</ul>
</div>
</div>
</div>
{%endfor%}
</div>
<div class="directional">
<button id="prev-{{block.id}}" type="button" aria-label="{{'carousel.controls.previous'|t}}">&#8249;</button>
<button id="next-{{block.id}}" type="button" aria-label="{{'carousel.controls.next'|t}}">&#8250;</button>
</div>
</div>
</div>
{%elsif request.design_mode%}
<div class="slider-liquid-empty" role="status" {{block.shopify_attributes}}>{{'carousel.empty.collection'|t}}</div>
{%endif%}
{%schema%}{"name":"t:ef","target":"section","available_if":"{{ app.metafields.billing.pro_access }}","stylesheet":"slider-10.css","javascript":"slider-10.js","disabled_on":{"groups":["header","footer"]},"settings":[{"type":"text","id":"accessibility_label","label":"t:w","default":"t:x"},{"type":"select","id":"collection_source","label":"t:y","options":[{"value":"all","label":"t:z"},{"value":"selected","label":"t:aa"}],"default":"all"},{"type":"collection","id":"selected_collection","label":"t:ab"},{"type":"select","id":"products_display_mode","label":"t:ac","options":[{"value":"limited","label":"t:ad"},{"value":"all","label":"t:ae"}],"default":"limited"},{"type":"range","id":"products_limit","label":"t:af","min":2,"max":8,"step":1,"default":3},{"type":"header","content":"t:ag"},{"type":"paragraph","content":"t:dt"},{"type":"select","id":"color_scheme_mode","label":"t:du","options":[{"value":"inherit","label":"t:dv"},{"value":"custom","label":"t:dw"}],"default":"inherit"},{"type":"color","id":"custom_background_color","label":"t:dx"},{"type":"color_background","id":"custom_background_gradient","label":"t:dy"},{"type":"color","id":"custom_text_color","label":"t:dz"},{"type":"color","id":"custom_button_color","label":"t:ea"},{"type":"color","id":"custom_button_text_color","label":"t:eb"},{"type":"color","id":"custom_outline_color","label":"t:ec"},{"type":"color","id":"custom_shadow_color","label":"t:ed"},{"type":"text","id":"section_height","label":"t:s","default":"700px"},{"type":"header","content":"t:ai"},{"type":"color","id":"text_color","label":"t:aj"},{"type":"text","id":"text_font_size","label":"t:ak","info":"t:al"},{"type":"color","id":"button_color","label":"t:am"},{"type":"color","id":"button_text_color","label":"t:an"},{"type":"text","id":"button_font_size","label":"t:ao","info":"t:ap"}]}{%endschema%}
