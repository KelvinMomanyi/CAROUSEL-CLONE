{%- assign s=block.settings -%}
{%liquid
assign c = s.collection
assign product_limit = s.product_limit
%}
<section
class="ms-section"
style="--ms-bg: {{s.background_color}}; --ms-text: {{s.text_color}}; --ms-accent: {{s.accent_color}}; --ms-padding: {{s.vertical_padding}}px; --ms-radius: {{s.card_radius}}px;"
{{block.shopify_attributes}}
>
<div class="ms-section__header">
<div>
{%if s.eyebrow != blank%}<p class="ms-section__eyebrow">{{s.eyebrow}}</p>{%endif%}
<h2 class="ms-section__heading">{{s.heading}}</h2>
{%if s.description != blank%}<p class="ms-section__copy">{{s.description}}</p>{%endif%}
</div>
</div>
<motion-coverflow class="ms-coverflow" data-autoplay="{{s.autoplay_speed}}">
<div class="ms-coverflow__stage">
{%if c != blank and c.products_count > 0%}
{%for p in c.products limit: product_limit%}
<div data-coverflow-card>
{%render 'motion-product-card', product: p%}
</div>
{%endfor%}
{%else%}
{%for index in (1..5)%}
<article class="ms-product-card" data-coverflow-card>
<div class="ms-product-card__media">{{'product-'|append: index|placeholder_svg_tag: 'ms-product-card__placeholder'}}</div>
<div class="ms-product-card__meta">
<h3 class="ms-product-card__title">{{'motion.sample_product'|t: number: index}}</h3>
<p class="ms-product-card__price">{{4900|money}}</p>
</div>
</article>
{%endfor%}
{%endif%}
</div>
<div class="ms-coverflow__controls">
<button class="ms-icon-button" type="button" data-coverflow-previous aria-label="{{'motion.previous'|t}}">←</button>
<button class="ms-icon-button" type="button" data-coverflow-next aria-label="{{'motion.next'|t}}">→</button>
</div>
</motion-coverflow>
</section>
{%schema%}{"name":"3D product coverflow","target":"section","stylesheet":"motion-sections.css","javascript":"motion-sections.js","settings":[{"type":"collection","id":"collection","label":"Collection"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Centre stage"},{"type":"text","id":"heading","label":"Heading","default":"Meet the icons"},{"type":"textarea","id":"description","label":"Description","default":"A dimensional showcase for the products that define your collection."},{"type":"range","id":"product_limit","label":"Products","min":3,"max":9,"step":1,"default":7},{"type":"range","id":"autoplay_speed","label":"Autoplay delay","info":"Set to 0 to turn autoplay off.","min":0,"max":10,"step":1,"unit":"s","default":5},{"type":"range","id":"card_radius","label":"Card corner radius","min":0,"max":40,"step":2,"unit":"px","default":24},{"type":"range","id":"vertical_padding","label":"Vertical padding","min":24,"max":120,"step":4,"unit":"px","default":72},{"type":"color","id":"background_color","label":"Background","default":"#1d1725"},{"type":"color","id":"text_color","label":"Text","default":"#f6f0ff"},{"type":"color","id":"accent_color","label":"Accent","default":"#c8a7ff"}]}{%endschema%}
