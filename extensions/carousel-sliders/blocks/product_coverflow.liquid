{%render 'analytics'%}{%-assign s=block.settings-%}{%liquid
assign c=s.collection
assign product_limit=s.product_limit
assign focus_scale=s.focus_scale|divided_by:100.0
assign rotation_speed=s.rotation_speed|divided_by:100.0
if c!=blank and c.products_count>0
assign visible_count=c.products_count|at_most:product_limit
else
assign visible_count=6
endif%}{%if app.metafields.billing.pro_access%}<section
data-carousel-root
data-carousel-layout="product_coverflow"
