class="ms-section ms-section--helix{%unless s.show_titles%} ms-section--helix--no-titles{%endunless%}"
style="
--ms-helix-height:{{s.section_height}}px;--ms-helix-card-w:{{s.card_width}}px;--ms-helix-card-h:{{s.card_height}}px;--ms-helix-radius:{{s.radius}}px;--ms-helix-perspective:{{s.perspective}}px;--ms-helix-card-radius:{{s.card_radius}}px;--ms-helix-edge-fade:{{s.edge_fade}}%;--ms-helix-bg:{{s.background_color}};--ms-helix-text:{{s.text_color}};--ms-helix-accent:{{s.accent_color}};--ms-helix-title-size:{{s.title_font_size}}px;"
{{block.shopify_attributes}}
><motion-helix-spiral
class="ms-helix"
data-arc-span="{{s.arc_span}}"
data-radius="{{s.radius}}"
data-path-spacing="{{s.path_spacing}}"
data-perspective="{{s.perspective}}"
data-card-width="{{s.card_width}}"
data-card-height="{{s.card_height}}"
data-focus-scale="{{focus_scale}}"
data-focus-falloff="{{s.focus_falloff}}"
data-depth-blur="{{s.depth_blur}}"
data-scroll-behavior="{{s.scroll_behavior}}"
data-scroll-loops="{{s.scroll_loops}}"
data-auto-rotation="{{s.auto_rotation}}"
data-rotation-speed="{{rotation_speed}}"
data-reverse="{{s.reverse}}"
data-drag-swipe="{{s.drag_swipe}}"
data-scroll-control="{{s.scroll_control}}"
data-card-count="{{visible_count}}"
tabindex="0"
role="region"
aria-roledescription="carousel"
aria-label="{{s.accessibility_label|escape}}"
><div class="ms-helix__stage" data-helix-stage>{%if c!=blank and c.products_count>0%}{%for p in c.products limit:product_limit%}<article
class="ms-helix__card"
data-helix-card
data-title="{{p.title|escape}}"
role="group"
aria-label="{{forloop.index}} of {{visible_count}}: {{p.title|escape}}"
aria-hidden="{%if forloop.first%}false{%else%}true{%endif%}"
>
<a class="ms-helix__link" href="{{p.url}}" tabindex="{%if forloop.first%}0{%else%}-1{%endif%}">
<span class="ms-helix__media">
{%if p.featured_image%}
{{p.featured_image|image_url:width:900|image_tag:loading:'lazy',widths:'240,360,540,720,900',sizes:'(min-width:750px) 190px,54vw',alt:p.featured_image.alt|default:p.title}}
{%else%}
{{'product-1'|placeholder_svg_tag:'ms-helix__placeholder'}}
{%endif%}
</span>
{%if s.show_titles%}<span class="ms-helix__title">{{p.title}}</span>{%endif%}
</a>
</article>{%endfor%}{%else%}{%for index in (1..6)%}{%assign sample_title='motion.sample_product'|t:number:index%}<article
class="ms-helix__card"
data-helix-card
data-title="{{sample_title|escape}}"
role="group"
aria-label="{{index}} of 6: {{sample_title|escape}}"
aria-hidden="{%if forloop.first%}false{%else%}true{%endif%}"
>
<span class="ms-helix__link">
<span class="ms-helix__media">{{'product-'|append:index|placeholder_svg_tag:'ms-helix__placeholder'}}</span>
{%if s.show_titles%}<span class="ms-helix__title">{{sample_title}}</span>{%endif%}
</span>
</article>{%endfor%}{%endif%}
</div>
<span class="ms-sr-only" data-helix-status aria-live="polite"></span>
