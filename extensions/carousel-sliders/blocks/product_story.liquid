{% render 'analytics' %}
{%-assign s=block.settings-%}
{%-assign c=s.collection-%}
<section
data-carousel-root
data-carousel-layout="product_story"
data-carousel-block-id="{{block.id}}" class="ms-section ms-section--depth-story{%unless s.reflection%} ms-section--depth-story--no-reflection{%endunless%}{%unless s.counter%} ms-section--depth-story--no-counter{%endunless%}" style="--ms-bg: {{s.background_color}}; --ms-text: {{s.text_color}}; --ms-padding: {{s.vertical_padding}}px; --ms-depth-height: {{s.carousel_height}}px; --ms-depth-card-w: {{s.card_width}}px; --ms-depth-card-h: {{s.card_height}}px; --ms-depth-side-scale: {{s.side_scale|divided_by:100.0}}; --ms-depth-spacing: {{s.card_spacing}}px; --ms-depth: {{s.depth}}px; --ms-depth-curve: {{s.curve}}deg; --ms-depth-perspective: {{s.perspective}}px; --ms-depth-stiffness: {{s.stiffness}}; --ms-depth-damping: {{s.damping}}; --ms-depth-radius: {{s.card_radius}}px; --ms-depth-blur: {{s.card_blur}}px; --ms-depth-reflect: {{s.reflection_opacity|divided_by:100.0}}; --ms-depth-vignette: {{s.vignette}}%; --ms-depth-edge-width: {{s.edge_width}}px; --ms-depth-edge-blur: {{s.edge_blur}}px;" {{block.shopify_attributes}}>
<motion-depth-story class="ms-depth-story" data-hint="{{s.hint|escape}}" aria-roledescription="carousel" aria-label="{{s.heading|escape}}">
<div class="ms-depth-story__stage" data-depth-stage>
{%-if c != blank and c.products_count > 0-%}
{%-for p in c.products limit:s.product_limit-%}
<article class="ms-depth-story__card" data-depth-card data-caption="{{p.title|escape}}" aria-hidden="{%if forloop.first%}false{%else%}true{%endif%}">
<a class="ms-depth-story__link" href="{{p.url}}" tabindex="{%if forloop.first%}0{%else%}-1{%endif%}">
{%-if p.featured_image-%}
{{p.featured_image|image_url:width:1200|image_tag:loading:'lazy',widths:'420, 640, 920, 1200',sizes:'(min-width: 750px) 460px, 76vw',alt:p.featured_image.alt|default:p.title}}
<span class="ms-depth-story__reflection" aria-hidden="true">
{{p.featured_image|image_url:width:1200|image_tag:loading:'lazy',widths:'420, 640, 920, 1200',sizes:'(min-width: 750px) 460px, 76vw',alt:''}}
</span>
{%-else-%}
<span class="ms-depth-story__media ms-depth-story__media--placeholder">
{{'product-'|append:forloop.index|placeholder_svg_tag}}
</span>
{%-endif-%}
</a>
</article>
{%-endfor-%}
{%-else-%}
{%-for index in (1..6)-%}
<article class="ms-depth-story__card" data-depth-card data-caption="{{'motion.story_chapter'|t:number:index|escape}}" aria-hidden="{%if forloop.first%}false{%else%}true{%endif%}">
<span class="ms-depth-story__link">
<span class="ms-depth-story__media ms-depth-story__media--placeholder">
{{'product-'|append:index|placeholder_svg_tag}}
</span>
</span>
</article>
{%-endfor-%}
{%-endif-%}
</div>
<div class="ms-depth-story__vignette" aria-hidden="true"></div>
<p class="ms-depth-story__meta" data-depth-meta aria-live="polite">
<span data-depth-caption></span><span class="ms-depth-story__counter" data-depth-counter></span>
</p>
<p class="ms-sr-only" data-depth-hint>{{s.hint}}</p>
</motion-depth-story>
</section>
{%schema%}{"name":"t:ii","target":"section","available_if":"{{ app.metafields.billing.pro_access }}","stylesheet":"motion-sections.css","javascript":"motion-depth-story.js","settings":[{"type":"collection","id":"collection","label":"t:ab"},{"type":"text","id":"heading","label":"t:hg","default":"t:ij"},{"type":"range","id":"product_limit","label":"t:ew","min":2,"max":8,"step":1,"default":6},{"type":"text","id":"hint","label":"t:ik","default":"t:il"},{"type":"header","content":"t:im"},{"type":"range","id":"carousel_height","label":"t:hi","min":420,"max":900,"step":10,"unit":"px","default":560},{"type":"range","id":"card_width","label":"t:ho","min":260,"max":700,"step":10,"unit":"px","default":460},{"type":"range","id":"card_height","label":"t:hp","min":180,"max":560,"step":10,"unit":"px","default":300},{"type":"range","id":"side_scale","label":"t:in","min":40,"max":90,"step":1,"unit":"%","default":66},{"type":"range","id":"card_spacing","label":"t:io","min":0,"max":120,"step":2,"unit":"px","default":40},{"type":"range","id":"depth","label":"Depth","min":0,"max":300,"step":10,"unit":"px","default":150},{"type":"range","id":"curve","label":"t:iq","min":0,"max":70,"step":1,"unit":"deg","default":42},{"type":"range","id":"perspective","label":"t:hm","min":600,"max":2000,"step":50,"unit":"px","default":1300},{"type":"range","id":"stiffness","label":"t:ir","min":80,"max":300,"step":5,"default":170},{"type":"range","id":"damping","label":"t:is","min":10,"max":80,"step":1,"default":34},{"type":"range","id":"card_radius","label":"t:fc","min":0,"max":40,"step":1,"unit":"px","default":6},{"type":"range","id":"card_blur","label":"t:it","min":0,"max":20,"step":1,"unit":"px","default":5},{"type":"checkbox","id":"reflection","label":"t:iu","default":true},{"type":"range","id":"reflection_opacity","label":"t:iv","min":0,"max":60,"step":1,"unit":"%","default":30},{"type":"checkbox","id":"counter","label":"t:iw","default":true},{"type":"range","id":"vignette","label":"t:ix","min":0,"max":100,"step":1,"unit":"%","default":0},{"type":"range","id":"edge_width","label":"t:iy","min":0,"max":100,"step":2,"unit":"px","default":22},{"type":"range","id":"edge_blur","label":"Edge blur","min":0,"max":40,"step":1,"unit":"px","default":14},{"type":"range","id":"vertical_padding","label":"t:es","min":0,"max":120,"step":4,"unit":"px","default":0},{"type":"color","id":"background_color","label":"t:bs","default":"#ECE5D8"},{"type":"color","id":"text_color","label":"t:ja","default":"#161413"}]}{%endschema%}
