{%- assign s=block.settings -%}
{%liquid
assign id = 'slider-06-'|append: block.id
if s.collection_source == 'selected'
assign c = s.selected_collection
else
assign c = collections.all
endif
assign m = s.products_limit|default: 3
assign d = s.products_display_mode|default: 'limited'
assign n = m
if d == 'all'
assign n = c.products_count|default: c.products.size|at_most: 8
endif
%}
{%if c != blank and c.products_count > 0%}
<div
id="{{id}}"
class="slider-06-root{%if s.text_color != blank%} has-slider-text-color{%endif%}{%if s.text_font_size != blank%} has-slider-text-size{%endif%}{%if s.button_color != blank%} has-slider-button-color{%endif%}{%if s.button_text_color != blank%} has-slider-button-text-color{%endif%}{%if s.button_font_size != blank%} has-slider-button-size{%endif%}"
{{block.shopify_attributes}}
data-carousel-root
data-carousel-layout="slider-06"
data-carousel-block-id="{{block.id}}"
role="region"
aria-roledescription="carousel"
aria-label="{{s.accessibility_label|escape}}"
style="--s06-height: {{s.section_height|escape}};{%render 'carousel-color-variables', s: s%}"
>
<section class="carousel">
<div class="list">
{%for p in c.products limit: n%}
{%assign v = p.selected_or_first_available_variant%}
<div class="item">
<figure>
{%if p.featured_image%}
{%assign l = 'lazy'%}{%if forloop.first%}{%assign l = 'eager'%}{%endif%}
{{p.featured_image|image_url: width: 1800|image_tag: widths: '360, 640, 960, 1200, 1800', sizes: '(max-width: 767px) 100vw, 62vw', loading: l, alt: p.featured_image.alt|default: p.title}}
{%else%}
{{'product-1'|placeholder_svg_tag: 'product-image-placeholder'}}
{%endif%}
</figure>
<div class="content">
{%if p.type != blank or p.vendor != blank%}
<p class="category">{{p.type|default: p.vendor|escape}}</p>
{%endif%}
<h2>{{p.title|escape}}</h2>
<p class="price">{{v.price|money_with_currency}}</p>
<p class="description">{{p.description|strip_html|truncatewords: 26}}</p>
<div class="more">
{%if p.has_only_default_variant%}
<form action="{{routes.cart_add_url}}" method="post" data-carousel-cart-form>
<input type="hidden" name="id" value="{{v.id}}">
<input type="hidden" name="quantity" value="1">
<button type="submit"{%unless v.available%} disabled{%endunless%}>{%if v.available%}{{'carousel.actions.add_to_cart'|t}}{%else%}{{'carousel.actions.sold_out'|t}}{%endif%}</button>
</form>
{%else%}
<button type="button" data-url="{{p.url}}" data-product-id="{{p.id}}" data-product-url>{{'carousel.actions.choose_options'|t}}</button>
{%endif%}
<button type="button" data-url="{{p.url}}" data-product-id="{{p.id}}" data-product-url><span aria-hidden="true">&#9654;</span> {{'carousel.actions.view_product'|t}}</button>
<p class="cart-feedback" aria-live="polite"></p>
</div>
</div>
</div>
{%endfor%}
</div>
<div class="arrows">
<button id="prev-{{block.id}}" data-slider-06-prev type="button" aria-label="{{'carousel.controls.previous'|t}}">&#8249;</button>
<button id="next-{{block.id}}" data-slider-06-next type="button" aria-label="{{'carousel.controls.next'|t}}">&#8250;</button>
</div>
<div class="indicators">
<ul>
{%for p in c.products limit: n%}
<li{%if forloop.first%} class="active"{%endif%}><button type="button" aria-label="{{p.title|escape}}"></button></li>
{%endfor%}
</ul>
</div>
</section>
</div>
{%elsif request.design_mode%}
<div class="slider-liquid-empty" role="status" {{block.shopify_attributes}}>{{'carousel.empty.collection'|t}}</div>
{%endif%}
{%schema%}{"name":"Carousel Swift Layout","target":"section","stylesheet":"slider-06.css","javascript":"slider-06.js","disabled_on":{"groups":["header","footer"]},"settings":[{"type":"text","id":"accessibility_label","label":"Accessibility label","default":"Featured products"},{"type":"select","id":"collection_source","label":"Product source","options":[{"value":"all","label":"All products"},{"value":"selected","label":"Selected collection"}],"default":"all"},{"type":"collection","id":"selected_collection","label":"Collection"},{"type":"select","id":"products_display_mode","label":"Products to show","options":[{"value":"limited","label":"Set number"},{"value":"all","label":"Maximum supported"}],"default":"limited"},{"type":"range","id":"products_limit","label":"Number of products","min":2,"max":8,"step":1,"default":3},{"type":"header","content":"Style Settings"},{"type":"paragraph","content":"Use layout defaults for broad theme compatibility, or choose explicit custom colors."},{"type":"select","id":"color_scheme_mode","label":"Color scheme","options":[{"value":"inherit","label":"Layout defaults"},{"value":"custom","label":"Use custom overrides"}],"default":"inherit"},{"type":"color","id":"custom_background_color","label":"Background color override"},{"type":"color_background","id":"custom_background_gradient","label":"Background gradient override"},{"type":"color","id":"custom_text_color","label":"Text color override"},{"type":"color","id":"custom_button_color","label":"Primary button/accent override"},{"type":"color","id":"custom_button_text_color","label":"Primary button text override"},{"type":"color","id":"custom_outline_color","label":"Secondary button/accent override"},{"type":"color","id":"custom_shadow_color","label":"Shadow color override"},{"type":"color","id":"custom_error_color","label":"Error message color override"},{"type":"text","id":"section_height","label":"Section height","default":"700px"},{"type":"header","content":"Text and Button Styling"},{"type":"color","id":"text_color","label":"Text color"},{"type":"text","id":"text_font_size","label":"Text font size","info":"Use a CSS size, for example 18px or 1.2rem."},{"type":"color","id":"button_color","label":"Button color"},{"type":"color","id":"button_text_color","label":"Button text color"},{"type":"text","id":"button_font_size","label":"Button font size","info":"Use a CSS size, for example 16px or 1rem."}]}{%endschema%}
