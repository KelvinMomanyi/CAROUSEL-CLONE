{%liquid
assign s = block.settings
assign c = blank
if s.collection_source == 'selected'
assign c = s.selected_collection
else
assign c = collections.all
endif
assign n = s.products_limit|default: 8|at_most: 16
assign id = 'shv-modern-'|append: block.id
%}
{%if c != blank and c.products_count > 0%}
<div
id="{{id}}"
class="shv-slider-wrapper gradient{%if s.enable_gradient_background%} shv-gradient-enabled shv-gradient-{{s.gradient_shape}}{%endif%}{%if s.text_color != blank%} has-slider-text-color{%endif%}{%if s.text_font_size != blank%} has-slider-text-size{%endif%}{%if s.button_color != blank%} has-slider-button-color{%endif%}{%if s.button_text_color != blank%} has-slider-button-text-color{%endif%}{%if s.button_font_size != blank%} has-slider-button-size{%endif%}"
data-carousel-root
data-carousel-layout="slider-12"
data-carousel-block-id="{{block.id}}"
role="region"
aria-roledescription="carousel"
aria-label="{{s.accessibility_label|escape}}"
style="
{%render 'carousel-responsive-variables', s: s, c: c%}
{%if s.custom_background_color != blank%}--shv-bg-rgb: {{s.custom_background_color.red}}, {{s.custom_background_color.green}}, {{s.custom_background_color.blue}}; --shv-bg: {{s.custom_background_color}};{%endif%}
{%if s.custom_background_gradient != blank%}--shv-custom-background: {{s.custom_background_gradient}};{%endif%}
{%if s.custom_text_color != blank%}--custom-text-color: {{s.custom_text_color}}; --shv-text-rgb: {{s.custom_text_color.red}}, {{s.custom_text_color.green}}, {{s.custom_text_color.blue}}; --shv-text: {{s.custom_text_color}};{%endif%}
{%if s.custom_button_color != blank%}--shv-button-rgb: {{s.custom_button_color.red}}, {{s.custom_button_color.green}}, {{s.custom_button_color.blue}}; --shv-button: {{s.custom_button_color}}; --shv-accent: {{s.custom_button_color}};{%endif%}
{%if s.custom_button_text_color != blank%}--shv-button-text-rgb: {{s.custom_button_text_color.red}}, {{s.custom_button_text_color.green}}, {{s.custom_button_text_color.blue}}; --shv-button-text: {{s.custom_button_text_color}};{%endif%}
{%if s.custom_outline_color != blank%}--shv-outline-rgb: {{s.custom_outline_color.red}}, {{s.custom_outline_color.green}}, {{s.custom_outline_color.blue}}; --shv-outline: {{s.custom_outline_color}};{%endif%}
{%if s.custom_shadow_color != blank%}--shv-shadow-rgb: {{s.custom_shadow_color.red}}, {{s.custom_shadow_color.green}}, {{s.custom_shadow_color.blue}};{%endif%}
{%if s.custom_error_color != blank%}--shv-error-rgb: {{s.custom_error_color.red}}, {{s.custom_error_color.green}}, {{s.custom_error_color.blue}}; --shv-error: {{s.custom_error_color}};{%endif%}
"
{{block.shopify_attributes}}
>
{%render 'carousel-main-content', c: c, n: n, modern: true%}
</div>
{%elsif request.design_mode%}
<div class="slider-liquid-empty" role="status" {{block.shopify_attributes}}>{{'carousel.empty.collection'|t}}</div>
{%endif%}
{%schema%}{"name":"Carousel: Modern","target":"section","stylesheet":"slider-12.css","javascript":"slider-12.js","disabled_on":{"groups":["header","footer"]},"settings":[{"type":"text","id":"accessibility_label","label":"Accessibility label","default":"Featured products"},{"type":"select","id":"collection_source","label":"Product source","options":[{"value":"all","label":"All products"},{"value":"selected","label":"Selected collection"}],"default":"all"},{"type":"collection","id":"selected_collection","label":"Collection"},{"type":"range","id":"products_limit","label":"Maximum products","min":2,"max":16,"step":1,"default":8},{"type":"range","id":"section_height","label":"Section height","min":360,"max":900,"step":20,"unit":"px","default":700},{"type":"header","content":"Large screen"},{"type":"select","id":"aspect_ratio_large","label":"Aspect ratio","options":[{"value":"auto","label":"Auto"},{"value":"16/9","label":"16:9"},{"value":"21/9","label":"21:9"},{"value":"4/3","label":"4:3"},{"value":"3/2","label":"3:2"},{"value":"1/1","label":"1:1"},{"value":"3/4","label":"3:4"},{"value":"9/16","label":"9:16"}],"default":"auto"},{"type":"select","id":"image_fit_large","label":"Image fit","options":[{"value":"contain","label":"Contain"},{"value":"cover","label":"Cover"}],"default":"cover"},{"type":"header","content":"Medium screen"},{"type":"select","id":"aspect_ratio_medium","label":"Aspect ratio","options":[{"value":"auto","label":"Auto"},{"value":"16/9","label":"16:9"},{"value":"4/3","label":"4:3"},{"value":"3/2","label":"3:2"},{"value":"1/1","label":"1:1"},{"value":"3/4","label":"3:4"},{"value":"9/16","label":"9:16"}],"default":"auto"},{"type":"select","id":"image_fit_medium","label":"Image fit","options":[{"value":"contain","label":"Contain"},{"value":"cover","label":"Cover"}],"default":"cover"},{"type":"header","content":"Small screen"},{"type":"select","id":"aspect_ratio_small","label":"Aspect ratio","options":[{"value":"auto","label":"Auto"},{"value":"9/16","label":"9:16"},{"value":"3/4","label":"3:4"},{"value":"1/1","label":"1:1"},{"value":"4/3","label":"4:3"},{"value":"16/9","label":"16:9"}],"default":"auto"},{"type":"select","id":"image_fit_small","label":"Image fit","options":[{"value":"contain","label":"Contain"},{"value":"cover","label":"Cover"}],"default":"cover"},{"type":"header","content":"Colors"},{"type":"color","id":"custom_background_color","label":"Background","default":"#111418"},{"type":"color_background","id":"custom_background_gradient","label":"Background gradient"},{"type":"color","id":"custom_text_color","label":"Text","default":"#ffffff"},{"type":"color","id":"custom_button_color","label":"Button","default":"#f1683a"},{"type":"color","id":"custom_button_text_color","label":"Button text","default":"#111418"},{"type":"color","id":"custom_outline_color","label":"Outline","default":"#ffffff"},{"type":"color","id":"custom_shadow_color","label":"Shadow","default":"#000000"},{"type":"color","id":"custom_error_color","label":"Error","default":"#ff6b6b"},{"type":"header","content":"Typography"},{"type":"text","id":"custom_title_size","label":"Title size"},{"type":"text","id":"custom_subtitle_size","label":"Product name size"},{"type":"text","id":"custom_price_size","label":"Price size"},{"type":"text","id":"custom_button_size","label":"Button size"},{"type":"color","id":"text_color","label":"Text override"},{"type":"text","id":"text_font_size","label":"Text size override"},{"type":"color","id":"button_color","label":"Button override"},{"type":"color","id":"button_text_color","label":"Button text override"},{"type":"text","id":"button_font_size","label":"Button size override"},{"type":"header","content":"Animated accent"},{"type":"checkbox","id":"enable_gradient_background","label":"Enable animated accent","default":true},{"type":"select","id":"gradient_shape","label":"Accent shape","options":[{"value":"rectangle","label":"Rectangle"},{"value":"rounded","label":"Rounded"},{"value":"pill","label":"Pill"},{"value":"slashed","label":"Slashed"},{"value":"angled-left","label":"Angled left"},{"value":"angled-right","label":"Angled right"},{"value":"chevron-right","label":"Chevron right"},{"value":"chevron-left","label":"Chevron left"},{"value":"notch-right","label":"Notch right"},{"value":"wave","label":"Wave"},{"value":"diagonal-cut","label":"Diagonal cut"}],"default":"rounded"},{"type":"range","id":"gradient_border_radius","label":"Accent radius","min":0,"max":50,"step":1,"default":18,"unit":"px"},{"type":"color","id":"gradient_color_start","label":"Accent start","default":"#f1683a"},{"type":"color","id":"gradient_color_end","label":"Accent end","default":"#8a2be2"}]}{%endschema%}
