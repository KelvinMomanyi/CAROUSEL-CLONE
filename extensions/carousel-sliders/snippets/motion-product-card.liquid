{%doc%}Motion product card.@param {product} product - Product.@param {string} [card_class] - Extra class.{%enddoc%}<article class="ms-product-card {{card_class}}"><a class="ms-product-card__link" href="{{product.url}}" aria-label="{{'motion.view_product'|t: product: product.title|escape}}"><div class="ms-product-card__media">{%if product.compare_at_price > product.price%}<span class="ms-product-card__badge">{{'motion.sale'|t}}</span>{%endif%}{%if product.featured_image%}{{product.featured_image|image_url: width: 900|image_tag: loading: 'lazy', widths: '240, 360, 540, 720, 900', sizes: '(min-width: 990px) 25vw, 70vw', alt: product.featured_image.alt|default: product.title}}{%else%}{{'product-1'|placeholder_svg_tag: 'ms-product-card__placeholder'}}{%endif%}</div><div class="ms-product-card__meta"><h3 class="ms-product-card__title">{{product.title}}</h3><p class="ms-product-card__price">{{product.price|money}}</p></div></a></article>